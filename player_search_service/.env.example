APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://player:player_pass@localhost:5432/player_db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# MinIO/S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=videos
S3_BUCKET_THUMBNAILS=thumbnails
S3_PRESIGNED_URL_EXPIRES=900