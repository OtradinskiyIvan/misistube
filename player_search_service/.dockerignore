venv/
ENV/
env/
.venv/

# ==================== TESTING & COVERAGE ====================
.pytest_cache/
.coverage
coverage.xml
coverage_html/
htmlcov/
.tox/
.nox/
.hypothesis/

# ==================== LOGS & RUNTIME DATA ====================
# Логи генерируются внутри контейнера, не копируем с хоста
logs/
*.log
tmp/
temp/

# ==================== IDE & EDITORS ====================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-*

# ==================== GIT & DOCKER CONFIGS ====================
.git/
.gitignore
.dockerignore
docker-compose*.yml
docker-compose*.yaml
Dockerfile*
*.dockerfile

# ==================== DOCUMENTATION & MISC ====================
*.md
LICENSE
LICENSE.txt
Makefile
README.md
docs/
CONTRIBUTING.md

# ==================== LOCAL SECRETS & CONFIGS ====================
# Никогда не включать секреты в образ!
.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# ==================== PROJECT-SPECIFIC (твоя структура) ====================
# Кэш pytest внутри tests/
tests/**/__pycache__/
tests/**/*.pyc

# Egg-info (генерируется при pip install -e .)
src/player_search_service.egg-info/

# Локальные конфиги тестов, если есть
testconfig.py
.pytest.ini