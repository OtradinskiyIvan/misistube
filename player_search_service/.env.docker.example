APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL — host.docker.internal работает и внутри Docker, и снаружи
# (на Linux требует extra_hosts, который у тебя уже есть в compose)
DATABASE_URL=postgresql+asyncpg://player:player_pass@host.docker.internal:5432/player_db

# Redis
REDIS_URL=redis://host.docker.internal:6379/0
REDIS_CACHE_TTL=300

# MinIO/S3
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_VIDEOS=videos
S3_BUCKET_THUMBNAILS=thumbnails
S3_PRESIGNED_URL_EXPIRES=900